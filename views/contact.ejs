<section class="contact-section">

    <h1 class="text-center">🗺️ Contact Me 🗺️</h1>

    <p class="text-center">
        Have a question or want to get in touch?
        Feel free to send me a message!
    </p>

    <form action="mailto:rohaan.khan@ontarotechu.net?subject=Contact_Form" method="POST" enctype="text/plain">

        <!-- First Name -->
        <label for="firstName">First Name</label>
        <input type="text" class="form-control" id="firstName" name="firstname" placeholder="Enter your first name"
            required>

        <!-- Last Name -->
        <label for="lastName">Last Name</label>
        <input type="text" class="form-control" id="lastname" name="lastname" placeholder="Enter your last name"
            required>

        <!-- Cell Number -->
        <label for="phone">Cell Number (xxx-xxx-xxxx)</label>
        <input type="tel" class="form-control" id="phone" name="phone" placeholder="Enter your cell phone number"
            pattern="[0-9]{3}-[0-9]{3}-[0-9]{4}" maxlength="12" required>

        <!-- Email -->
        <label for="email">Email</label>
        <input type="email" class="form-control" id="email" name="email" placeholder="Enter your email" required>

        <!-- Message -->
        <label for="message">Message</label>
        <textarea class="form-control" id="message" name="message" rows="5" placeholder="Write your message here..."
            required></textarea>

        <!-- Checkbox -->
        <div class="form-check mb-3">
            <input type="checkbox" class="form-check-input" id="robot" name="robot" required>

            <label class="form-check-label" for="robot">
                I'm not a robot🤖
            </label>
        </div>

        <!-- Submit and Reset Buttons -->
        <button type="submit" class="btn">
            Submit
        </button>

        <button type="reset" class="btn btn-secondary">
            Reset
        </button>

    </form>

</section>